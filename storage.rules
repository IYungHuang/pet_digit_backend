rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function activeMember(roomId) {
      return signedIn() && firestore.exists(/databases/(default)/documents/rooms/$(roomId)/members/$(request.auth.uid)) && firestore.get(/databases/(default)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.active == true;
    }
    function validMime() {
      return request.resource != null && request.resource.contentType in [
        'image/jpeg', 'image/png', 'image/gif', 'image/webp',
        'video/mp4', 'video/quicktime'
      ];
    }
    function validSize() { return request.resource != null && request.resource.size <= 52428800; }

    // User avatar storage
    match /users/{uid}/avatar {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid && validMime() && validSize();
    }

    // Pet avatar and photo/media gallery storage
    match /users/{uid}/pets/{petId}/avatar {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid && validMime() && validSize();
    }
    match /users/{uid}/pets/{petId}/photos/{photoId} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid && validMime() && validSize();
    }
    match /users/{uid}/pets/{petId}/media/{mediaId} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid && validMime() && validSize();
    }

    match /rooms/{roomId}/staging/{uid}/{clientId}/original {
      allow read: if signedIn() && request.auth.uid == uid && activeMember(roomId);
      allow create: if signedIn() && request.auth.uid == uid && activeMember(roomId) &&
        roomId.size() > 0 && clientId.size() > 0 && validMime() && validSize() && resource == null;
      allow update, delete: if false;
    }
    match /rooms/{roomId}/media/{messageId}/{variant} {
      allow read: if signedIn() && activeMember(roomId);
      allow write, delete: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
