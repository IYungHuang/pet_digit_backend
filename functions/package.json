{
  "name": "pet-digit-functions",
  "private": true,
  "engines": { "node": "20" },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "eslint src test vitest.config.ts --ext .ts,.cjs --report-unused-disable-directives",
    "typecheck": "tsc --noEmit",
    "emulator": "node scripts/emulator-run.mjs start",
    "test": "vitest run test/contracts.test.ts test/message-contract.test.ts test/fixtures.test.ts test/app-check.test.ts test/recovery.test.ts test/scheduler.test.ts test/deployment.test.ts test/media-stream.test.ts",
    "test:rules": "node scripts/emulator-run.mjs rules",
    "test:rules:local": "node test/rules.test.cjs",
    "test:integration": "node scripts/emulator-run.mjs integration",
    "test:integration:local": "vitest run test/emulator.integration.test.ts test/storage.integration.test.ts test/query-contract.integration.test.ts",
    "test:emulator:local": "npm run test:rules:local && npm run test:integration:local",
    "verify": "npm run lint && npm run typecheck && npm run build && npm test && node scripts/emulator-run.mjs verify && git -C .. diff --check",
    "test:watch": "vitest"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^2.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "firebase": "^9.23.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "xhr2": "^0.2.1"
  }
}
